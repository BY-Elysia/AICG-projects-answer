#version 440 core

// One 16x16 workgroup owns one tile, so each invocation exclusively writes its pixel.
layout(local_size_x = 16, local_size_y = 16) in;

struct PreparedVertex {
    // xy is the pixel-space position, z is normalized depth, and w is reciprocal clip-space w.
    vec4 screenAndInvW;

    // xyz is the world-space position reconstructed later by the shading pass.
    vec4 worldPosition;

    // xyz is the world-space vertex normal.
    vec4 normal;

    // xy is the material texture coordinate.
    vec4 uv;
};

struct PreparedTriangle {
    // The three screen-space vertices submitted by the shared CPU scene-preparation stage.
    PreparedVertex vertices[3];

    // xyz is the world-space tangent used by normal mapping.
    vec4 tangent;

    // xyz is the world-space bitangent used by normal mapping.
    vec4 bitangent;
};

// Shared triangle input. Tile-list indices identify elements in this array.
layout(std430, binding = 0) readonly buffer TriangleBuffer { PreparedTriangle triangles[]; };

// Number of binning attempts for each tile. Counts can exceed the list capacity.
layout(std430, binding = 1) readonly buffer TileCountBuffer { uint tileCounts[]; };

// Fixed-capacity triangle-index lists generated by binning.comp.
layout(std430, binding = 2) readonly buffer TileIndexBuffer { uint tileIndices[]; };

// Full float depth and primitive identity form the compute visibility buffer.
layout(r32f, binding = 0) uniform image2D uDepth;
layout(r32ui, binding = 1) uniform uimage2D uOwner;

// Number of valid entries in triangles[].
uniform int uTriangleCount;

// Full render-target dimensions in pixels.
uniform vec2 uExtent;

// Number of tiles in the horizontal and vertical directions.
uniform vec2 uTileExtent;

// Pixel width and height of one square tile; it matches the compute workgroup dimensions.
uniform int uTileSize;

// Maximum number of retained triangle indices for one tile.
uniform int uMaxTrianglesPerTile;

float cross2D(vec2 lhs, vec2 rhs) {
    // The signed z component of the two-dimensional cross product lhs x rhs.
    return lhs.x * rhs.y - lhs.y * rhs.x;
}

void main() {
    // The workgroup coordinate selects the tile that this group owns exclusively.
    const ivec2 tile = ivec2(gl_WorkGroupID.xy);

    // The local invocation coordinate selects one pixel inside the tile.
    const ivec2 pixel = tile * uTileSize + ivec2(gl_LocalInvocationID.xy);

    // Tiles at the framebuffer edge can contain invocations outside the valid pixel rectangle.
    if (any(greaterThanEqual(pixel, ivec2(uExtent)))) {
        return;
    }

    // Flatten the tile coordinate to locate its count and consecutive index-list region.
    const uint tileIndex = uint(tile.y * int(uTileExtent.x) + tile.x);

    // Binning may count more triangles than fit in the fixed list, so clamp before reading.
    const uint count = min(tileCounts[tileIndex], uint(uMaxTrianglesPerTile));

    // Start at the far plane; the nearest accepted triangle replaces this value.
    float closestDepth = 1.0;

    // 0xffffffff is the shared background sentinel consumed by shading.comp.
    uint owner = 0xffffffffu;

    // Raster coverage is evaluated at the conventional center of each output pixel.
    const vec2 samplePosition = vec2(pixel) + vec2(0.5);

    // Test only triangles whose conservative bounding boxes touched this tile during binning.
    for (uint entry = 0u; entry < count; ++entry) {
        // Read one triangle index from this tile's fixed-capacity list.
        const uint triangleIndex = tileIndices[tileIndex * uint(uMaxTrianglesPerTile) + entry];

        // Retain a defensive validation before indexing the shared triangle buffer.
        if (triangleIndex >= uint(uTriangleCount)) {
            continue;
        }

        const PreparedTriangle triangle = triangles[triangleIndex];

        // The vertices are already in framebuffer pixel coordinates.
        const vec2 a = triangle.vertices[0].screenAndInvW.xy;
        const vec2 b = triangle.vertices[1].screenAndInvW.xy;
        const vec2 c = triangle.vertices[2].screenAndInvW.xy;

        // Reject back-facing and degenerate triangles with the shared winding convention.
        const float area = cross2D(b - a, c - a);

        if (area <= 0.0) {
            continue;
        }

        // The three signed sub-areas are unnormalized barycentric coordinates at this pixel.
        vec3 barycentric = vec3(
            cross2D(c - b, samplePosition - b), cross2D(a - c, samplePosition - c),
            cross2D(b - a, samplePosition - a));

        // A negative sub-area means the pixel center is outside this front-facing triangle.
        if (any(lessThan(barycentric, vec3(0.0)))) {
            continue;
        }

        // Dividing by the full signed area normalizes the weights so that they sum to one.
        barycentric /= area;

        // Depth is affine in post-projection screen space, so barycentric interpolation is valid.
        const float depth = dot(
            barycentric,
            vec3(
                triangle.vertices[0].screenAndInvW.z, triangle.vertices[1].screenAndInvW.z,
                triangle.vertices[2].screenAndInvW.z));

        // Strict comparison keeps the first tile-list entry when depths are exactly equal.
        if (depth < closestDepth) {
            closestDepth = depth;
            owner = triangleIndex;
        }
    }

    // Shading reconstructs attributes from owner; depth is retained as a hardware-like visibility attachment.
    imageStore(uDepth, pixel, vec4(closestDepth));
    imageStore(uOwner, pixel, uvec4(owner));
}
